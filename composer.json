{
    "name": "amjadiqbal/filament-audience-sync",
    "description": "Email-marketing audience sync for Filament 4 and 5: subscribe, unsubscribe, tag and update your records in a Mailchimp audience or Brevo list, with queued bulk sync, a status column and list stats. Driver-based.",
    "keywords": [
        "filament",
        "filament-plugin",
        "filamentphp",
        "laravel",
        "newsletter",
        "email-marketing",
        "mailing-list",
        "audience",
        "subscribers",
        "mailchimp",
        "brevo"
    ],
    "homepage": "https://amjad.com.pk/filament/plugins/filament-audience-sync",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Amjad Iqbal",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/amjadiqbal/filament-audience-sync/issues",
        "source": "https://github.com/amjadiqbal/filament-audience-sync",
        "docs": "https://amjad.com.pk/filament/plugins/filament-audience-sync"
    },
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\FilamentAudienceSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\FilamentAudienceSync\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmjadIqbal\\FilamentAudienceSync\\FilamentAudienceSyncServiceProvider"
            ],
            "aliases": {
                "AudienceSync": "AmjadIqbal\\FilamentAudienceSync\\Facades\\AudienceSync"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
